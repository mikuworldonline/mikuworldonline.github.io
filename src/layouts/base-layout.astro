---
import BaseHead from "@/components/layout/base-head.astro";
import TailwindIndicator from "@/components/tailwind-indicator.astro";
// NOTE: work with { Toaster } from "@/components/ui/sonner" but need to update dark theme
import { Toaster } from "sonner";
import { isIndex, getCoverImage } from "@/config/site";
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description?: string;
  bodyClass?: string;
  bgImg?: string;
};

const { title, description, bodyClass } = Astro.props;

const bodyStyle: any = {};
if (isIndex(Astro.url)) {
  const img = getCoverImage();
  bodyStyle.background = `url(${img.img}) no-repeat`;
  bodyStyle.backgroundSize = img.size;
  bodyStyle.backgroundPosition = img.position;
}

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class={cn("flex flex-col min-h-screen", bodyClass)} style={bodyStyle}>
    <slot />
    <TailwindIndicator />
    <Toaster richColors client:only="react" />
  </body>
</html>
