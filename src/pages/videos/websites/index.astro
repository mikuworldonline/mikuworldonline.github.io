---
export const prerender = false;

import MainLayout from "@/layouts/main-layout.astro";
import { videoSites } from "@/pages/api/videos/websites";
import { VideoSitesList } from "@/pages/videos/websites/template";
---

<MainLayout title="投稿网站 - 初音未来资源导航">
  <section class="container py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">投稿网站</h1>
      <p class="text-muted-foreground">收录初音未来相关视频投稿网站、资源站、官方平台的导航入口</p>
    </div>
    <VideoSitesList data={videoSites} client:load />
  </section>
</MainLayout>
