---
export const prerender = false;

import MainLayout from "@/layouts/main-layout.astro";
import { avatars } from "@/pages/api/pictures/avatar";
import { AvatarList } from "@/pages/pictures/avatar/template";
---

<MainLayout title="头像 - 初音未来头像精选">
  <section class="container py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">头像</h1>
      <p class="text-muted-foreground">精选初音未来主题头像，圆角方形设计，适合社交平台使用</p>
    </div>
    <AvatarList data={avatars} client:load />
  </section>
</MainLayout>
